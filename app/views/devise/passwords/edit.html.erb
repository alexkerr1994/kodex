<% content_for :title, "Choose a new password" %>

<h1 class="auth-title">Choose a new password.</h1>
<p class="auth-sub">Pick something you'll remember.</p>

<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, class: "auth-form" do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="auth-field">
    <%= f.label :password, "New password" %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
          placeholder: "At least #{@minimum_password_length} characters", class: "auth-input" %>
  </div>

  <div class="auth-field">
    <%= f.label :password_confirmation, "Confirm new password" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
  </div>

  <%= f.submit "Change password", class: "auth-btn" %>
<% end %>

<div class="auth-links">
  <p><%= link_to "Back to sign in", new_session_path(resource_name) %></p>
</div>
