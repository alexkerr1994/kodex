<% content_for :title, "Reset password" %>

<h1 class="auth-title">Reset your password.</h1>
<p class="auth-sub">Enter your email and we'll send you a reset link.</p>

<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :post, class: "auth-form" do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="auth-field">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "auth-input" %>
  </div>

  <%= f.submit "Send reset link", class: "auth-btn" %>
<% end %>

<div class="auth-links">
  <p><%= link_to "Back to sign in", new_session_path(resource_name) %></p>
</div>
