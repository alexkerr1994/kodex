<% content_for :title, "Edit event" %>
<%# Loaded into the calendar's #event_detail frame → Turbo shows just the frame
    as a popover; the .event-form-page wrapper is the standalone fallback. %>
<div class="event-form-page">
  <div class="settings-group">
    <%= turbo_frame_tag "event_detail" do %>
      <div class="event-pop-inner event-pop-form">
        <div class="event-pop-actions">
          <h3 class="event-pop-title">Edit event</h3>
          <%= button_to event_path(@event), method: :delete, class: "icon-btn", title: "Delete",
                form: { data: { turbo_frame: "_top", turbo_confirm: "Delete “#{@event.title}”#{' and all its occurrences' unless @event.once?}?" } } do %><%= icon(:trash, size: 18) %><% end %>
          <button type="button" class="icon-btn" title="Close" data-action="popover#close"><%= icon(:close, size: 18) %></button>
        </div>

        <% unless @event.once? %>
          <p class="hint">This is a repeating event — changes apply to the whole series.</p>
        <% end %>

        <%= render "form", event: @event %>
      </div>
    <% end %>
  </div>
</div>
