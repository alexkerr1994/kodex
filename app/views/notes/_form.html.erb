<%= form_with model: note do |f| %>
  <% if note.errors.any? %>
    <div class="errors">
      <ul>
        <% note.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, autofocus: true %>
  </div>

  <div class="field">
    <%= f.label :body %>
    <%= f.text_area :body, rows: 12 %>
  </div>

  <div class="actions">
    <%= f.submit class: "btn" %>
    <%= link_to "Cancel", (note.persisted? ? note : notes_path), class: "linkish" %>
  </div>
<% end %>
