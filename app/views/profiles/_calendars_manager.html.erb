<div id="calendars_manager">
  <% if error.present? %>
    <div class="errors"><%= error %></div>
  <% end %>

  <% if calendars.any? %>
    <ul class="tag-manage-list">
      <% calendars.each do |calendar| %>
        <li class="tag-manage-row">
          <%= form_with model: calendar, url: manage_calendar_path(calendar), method: :patch, class: "tag-manage-form" do |f| %>
            <div class="color-picker" data-controller="color-picker">
              <%= f.hidden_field :color, data: { color_picker_target: "input" } %>
              <button type="button" class="color-trigger" style="background: <%= calendar.color %>"
                      title="Choose colour" data-color-picker-target="button" data-action="color-picker#toggle"></button>
              <div class="color-popover" data-color-picker-target="popover" hidden>
                <div class="color-swatches">
                  <% Calendar::PALETTE.each do |c| %>
                    <button type="button" class="color-dot" style="background: <%= c %>" data-color="<%= c %>" data-action="color-picker#pick"></button>
                  <% end %>
                </div>
                <div class="color-custom">
                  <input type="color" class="color-native" data-color-picker-target="native" data-action="color-picker#useNative">
                  <input type="text" class="color-hex" maxlength="7" placeholder="#RRGGBB" data-color-picker-target="hex" data-action="input->color-picker#useHex">
                </div>
              </div>
            </div>
            <%= f.text_field :name, class: "tag-name-input" %>
            <span class="tag-count"><%= pluralize(calendar.events.count, "event") %></span>
            <%= f.submit "Save", class: "btn small" %>
          <% end %>
          <%= button_to manage_calendar_path(calendar), method: :delete, class: "linkish danger",
                form: { data: { turbo_confirm: "Delete calendar ‘#{calendar.name}’ and its events?" } } do %>
            Delete
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No calendars yet — add one below.</p>
  <% end %>

  <%= form_with model: Calendar.new, url: manage_calendars_path, class: "referral-form" do |f| %>
    <%= f.text_field :name, placeholder: "New calendar name", required: true %>
    <%= f.submit "Add calendar", class: "btn" %>
  <% end %>
</div>
