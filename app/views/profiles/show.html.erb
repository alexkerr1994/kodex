<% content_for :title, "Settings" %>
<%
  theme_swatches = {
    "quill"  => { label: "Warm",   bg: "#f6f1ea", accent: "#a06e57" },
    "clean"  => { label: "Clean",  bg: "#f9fafb", accent: "#2563eb" },
    "paper"  => { label: "Paper",  bg: "#f4ecd8", accent: "#b5622d" },
    "modern" => { label: "Dark",   bg: "#0f172a", accent: "#6366f1" },
    "tron"   => { label: "Tron",   bg: "#05070f", accent: "#00e5ff" }
  }
%>

<div class="app-shell app-shell--settings" data-controller="sidebar" data-sidebar-default-collapsed-value="<%= current_user.start_collapsed %>">
  <%= render "notes/sidebar", active: nil %>

  <section class="settings-area">
    <div class="settings-topbar">
      <h2>Settings</h2>
    </div>

    <div class="settings-body" data-controller="tabs" data-tabs-active-value="<%= @tab %>">
      <div class="editor-tabs settings-tabs">
        <button type="button" class="tab" data-tabs-target="tab" data-name="account" data-action="tabs#select" data-tabs-name-param="account">Account</button>
        <button type="button" class="tab" data-tabs-target="tab" data-name="app" data-action="tabs#select" data-tabs-name-param="app">App</button>
        <button type="button" class="tab" data-tabs-target="tab" data-name="organization" data-action="tabs#select" data-tabs-name-param="organization">Organization</button>
        <button type="button" class="tab" data-tabs-target="tab" data-name="networks" data-action="tabs#select" data-tabs-name-param="networks">Networks</button>
      </div>

      <div class="settings-inner">
        <%# ================= Account ================= %>
        <div class="pane" data-tabs-target="pane" data-name="account" hidden>
          <% if @user.errors.any? && @tab == "account" %>
            <div class="errors"><ul><% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
          <% end %>

          <%= form_with model: @user, url: profile_path, method: :patch, data: { turbo: false } do |f| %>
            <%= hidden_field_tag :return_tab, "account" %>
            <section class="settings-group">
              <h3>Profile</h3>
              <div class="field">
                <span class="field-label">Profile photo</span>
                <div class="avatar-edit" data-controller="file-input">
                  <span class="avatar lg">
                    <% if @user.avatar.attached? %><%= avatar_image_tag(@user, 64) %><% else %><%= @user.display_name.first.upcase %><% end %>
                  </span>
                  <div class="avatar-controls">
                    <label class="btn small file-btn">
                      Choose photo
                      <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "visually-hidden", data: { action: "file-input#update" } %>
                    </label>
                    <span class="file-name" data-file-input-target="name">No file chosen</span>
                    <% if @user.avatar.attached? %>
                      <label class="hint"><%= check_box_tag "user[remove_avatar]", "1" %> Remove current photo</label>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="field">
                <%= f.label :name, "Display name" %>
                <%= f.text_field :name, placeholder: "Your name" %>
              </div>
              <div class="field">
                <%= f.label :username, "Username" %>
                <%= f.text_field :username, autocomplete: "username" %>
                <p class="hint">Used to sign in (alongside your email). Letters, numbers, dots, underscores, hyphens.</p>
              </div>
              <div class="actions"><%= f.submit "Save profile", class: "btn" %></div>
            </section>
          <% end %>

          <%= form_with model: @user, url: profile_account_path, method: :patch do |f| %>
            <section class="settings-group">
              <h3>Email</h3>
              <div class="field">
                <%= f.label :email, "Email address" %>
                <%= f.email_field :email, autocomplete: "email" %>
              </div>
            </section>

            <section class="settings-group">
              <h3>Password</h3>
              <p class="muted">Leave the password fields blank to keep your current password.</p>
              <div class="field">
                <%= f.label :password, "New password" %>
                <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••" %>
              </div>
              <div class="field">
                <%= f.label :password_confirmation, "Confirm new password" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
              </div>
              <div class="field">
                <%= f.label :current_password, "Current password" %>
                <%= f.password_field :current_password, autocomplete: "current-password", required: true %>
                <span class="hint">Required to save any email or password change.</span>
              </div>
            </section>

            <div class="actions"><%= f.submit "Update account", class: "btn" %></div>
          <% end %>

          <section class="settings-group">
            <h3>Invite a friend</h3>
            <p class="muted">Send someone an email invitation to join.</p>
            <%= form_with url: profile_referral_path, method: :post, class: "referral-form" do %>
              <%= email_field_tag :email, nil, placeholder: "friend@example.com", required: true %>
              <%= submit_tag "Send invite", class: "btn" %>
            <% end %>
          </section>

          <section class="settings-group danger-zone">
            <h3>Danger zone</h3>
            <p class="muted">This permanently deletes your account, the notes you own, your tags, and your access to shared notes. This cannot be undone.</p>
            <%= button_to "Delete my account", profile_path, method: :delete, class: "btn danger",
                  form: { data: { turbo_confirm: "Permanently delete your account and all notes you own?" } } %>
          </section>
        </div>

        <%# ================= App ================= %>
        <div class="pane" data-tabs-target="pane" data-name="app" hidden>
          <% if @user.errors.any? && @tab == "app" %>
            <div class="errors"><ul><% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
          <% end %>

          <%= form_with model: @user, url: profile_path, method: :patch, data: { turbo: false } do |f| %>
            <%= hidden_field_tag :return_tab, "app" %>
            <section class="settings-group">
              <h3>Appearance</h3>
              <div class="field">
                <span class="field-label">Theme</span>
                <div class="theme-grid">
                  <% User::THEMES.each do |name| %>
                    <% s = theme_swatches[name] %>
                    <label class="theme-option">
                      <%= f.radio_button :theme, name, class: "visually-hidden" %>
                      <span class="theme-swatch" style="background: <%= s[:bg] %>"><span class="theme-dot" style="background: <%= s[:accent] %>"></span></span>
                      <span class="theme-name"><%= s[:label] %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            </section>

            <section class="settings-group">
              <h3>Region &amp; startup</h3>
              <div class="field">
                <%= f.label :time_zone, "Timezone" %>
                <%= f.time_zone_select :time_zone, nil, { include_blank: "Use app default (#{Rails.application.config.time_zone})" } %>
              </div>
              <div class="field">
                <%= f.label :holiday_region, "Public holidays" %>
                <%= f.select :holiday_region, User::HOLIDAY_REGIONS.map { |code, name| [name, code] }, { include_blank: "None" } %>
                <p class="hint">Overlays your region's public holidays on the calendar.</p>
              </div>
              <div class="field">
                <%= f.label :default_view, "Open notes in" %>
                <%= f.select :default_view, User::DEFAULT_VIEWS.map { |v| [v.capitalize, v] } %>
              </div>
              <label class="checkbox"><%= f.check_box :start_collapsed %> Start with the sidebar collapsed</label>
            </section>

            <div class="actions"><%= f.submit "Save", class: "btn" %></div>
          <% end %>
        </div>

        <%# ================= Organization ================= %>
        <div class="pane" data-tabs-target="pane" data-name="organization" hidden>
          <section class="settings-group">
            <h3>Tags</h3>
            <p class="muted">Rename, recolour, or delete your tags. Changes apply everywhere you use them.</p>
            <%= render "tags_manager", tags: current_user.tags.order(:name), error: nil %>
          </section>

          <section class="settings-group">
            <h3>Folders</h3>
            <p class="muted">Rename or delete your folders. Deleting a folder unfiles its notes — it won't delete them.</p>
            <%= render "folders_manager", folders: current_user.folders.order(:name), error: nil %>
          </section>

          <section class="settings-group">
            <h3>Calendars</h3>
            <p class="muted">Create calendars (e.g. Professional, Personal), rename or recolour them. Deleting a calendar also deletes its events.</p>
            <%= render "calendars_manager", calendars: current_user.calendars.order(:name), error: nil %>
          </section>
        </div>

        <%# ================= Networks ================= %>
        <div class="pane" data-tabs-target="pane" data-name="networks" hidden>
          <%= render "networks" %>
        </div>
      </div>
    </div>
  </section>
</div>
