<%# User chip with an account dropdown (Settings + Sign out), opened from the
    gear where the settings icon used to live. Shared by the notes + calendar sidebars. %>
<div class="user-card" data-controller="menu">
  <div class="avatar">
    <% if current_user.avatar.attached? %><%= avatar_image_tag(current_user, 38) %><% else %><%= current_user.display_name.first.upcase %><% end %>
  </div>
  <div class="user-meta">
    <span class="user-name"><%= current_user.display_name %><%= " · admin" if current_user.admin? %></span>
    <span class="user-email"><%= current_user.email %></span>
  </div>
  <button type="button" class="icon-btn user-settings" data-action="menu#toggle" data-menu-target="button" aria-haspopup="menu" aria-expanded="false" title="Account menu">
    <%= icon(:settings, size: 18) %>
  </button>

  <div class="user-menu" data-menu-target="menu" role="menu" hidden>
    <%= link_to profile_path, class: "user-menu-item", role: "menuitem" do %>
      <%= icon(:settings, size: 16) %><span>Settings</span>
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete, class: "user-menu-item", role: "menuitem", form: { data: { turbo: false } } do %>
      <%= icon(:logout, size: 16) %><span>Sign out</span>
    <% end %>
  </div>
</div>
