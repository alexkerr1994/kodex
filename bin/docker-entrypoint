#!/bin/bash -e

# PaaS platforms (e.g. Railway) inject $PORT and expect the app to listen on it.
# Thruster listens on $HTTP_PORT (default 80), so mirror $PORT into it. Guarded,
# so self-hosted Kamal (no $PORT) keeps using the default port 80.
if [ -n "${PORT}" ]; then
  export HTTP_PORT="${PORT}"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
